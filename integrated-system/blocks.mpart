function sl_setup(block)
block.NumDialogPrms=3;block.DialogPrmsTunable={'Nontunable','Nontunable','Nontunable'};
kind=block.DialogPrm(1).Data;p=block.DialogPrm(2).Data;
switch kind
 case 'load',inputs=[];outputs=[1 3 2];
 case 'controller',inputs=[5 1];outputs=[2 14];
 case 'driver',inputs=2;outputs=2;
 case 'plant',inputs=[2 3];outputs=[5 29];
 case 'observer',inputs=[29 14 1 2 2];outputs=[51 1 1 2];
 otherwise,error('FYP:BlockKind','Unknown block kind: %s',kind);
end
block.NumInputPorts=numel(inputs);block.NumOutputPorts=numel(outputs);block.NumContStates=0;
block.SetPreCompInpPortInfoToDynamic;block.SetPreCompOutPortInfoToDynamic;
for j=1:numel(inputs)
 block.InputPort(j).Dimensions=inputs(j);block.InputPort(j).DatatypeID=0;block.InputPort(j).Complexity='Real';
 block.InputPort(j).DirectFeedthrough=~strcmp(kind,'plant');
end
for j=1:numel(outputs)
 block.OutputPort(j).Dimensions=outputs(j);block.OutputPort(j).DatatypeID=0;block.OutputPort(j).Complexity='Real';
end
block.SampleTimes=[1/p.fsw 0];block.SimStateCompliance='DefaultSimState';
block.RegBlockMethod('PostPropagationSetup',@sl_dwork);
block.RegBlockMethod('InitializeConditions',@sl_initialize);
block.RegBlockMethod('Outputs',@sl_outputs);
if any(strcmp(kind,{'load','controller','plant'})),block.RegBlockMethod('Update',@sl_update);end
end

function sl_dwork(block)
kind=block.DialogPrm(1).Data;
switch kind
 case 'load',n=1;
 case 'controller',n=15;
 case 'plant',n=36;
 otherwise,n=0;
end
block.NumDworks=double(n>0);
if n>0
 block.Dwork(1).Name='state';block.Dwork(1).Dimensions=n;block.Dwork(1).DatatypeID=0;
 block.Dwork(1).Complexity='Real';block.Dwork(1).UsedAsDiscState=true;
end
end

function sl_initialize(block)
kind=block.DialogPrm(1).Data;p=block.DialogPrm(2).Data;c=block.DialogPrm(3).Data;
switch kind
 case 'load',block.Dwork(1).Data=1;
 case 'controller'
  state=zeros(15,1);state(4)=double(c.n0>=p.nmax);state(5)=double(c.n0<=p.nmin);
  % The measured initial bus value is latched in the first Outputs call.
  block.Dwork(1).Data=state;
 case 'plant'
  y=zeros(24,1);y(2)=c.n0*2*pi/60;y(3)=c.V0;
  g=[-1 -1 inf 0];if c.on && ~c.block,g=[0 0 inf 0];end
  state=[y;g';0;y(2);energy(y,p);zeros(5,1)];block.Dwork(1).Data=state;
end
end

function sl_outputs(block)
kind=block.DialogPrm(1).Data;p=block.DialogPrm(2).Data;c=block.DialogPrm(3).Data;
% Snap to the integer PWM tick, avoiding accumulated floating clock drift.
Ts=1/p.fsw;t=round(block.CurrentTime/Ts)*Ts;
switch kind
 case 'load'
  [power,q,flags]=sl_load(t,block.Dwork(1).Data,p,c);
  block.OutputPort(1).Data=power;block.OutputPort(2).Data=q;block.OutputPort(3).Data=flags;
 case 'controller'
  [command,telemetry]=sl_control(t,block.Dwork(1).Data,block.InputPort(1).Data,block.InputPort(2).Data,p,c);
  block.OutputPort(1).Data=command;block.OutputPort(2).Data=telemetry;
 case 'driver'
  block.OutputPort(1).Data=sl_driver(block.InputPort(1).Data,p);
 case 'plant'
  state=block.Dwork(1).Data;
  block.OutputPort(1).Data=[state(1:3);state(29:30)];
  block.OutputPort(2).Data=[state(1:24);state(29);state(31:33);state(35)];
 case 'observer'
  state=block.InputPort(1).Data;tele=block.InputPort(2).Data;power=block.InputPort(3).Data;
  flags=block.InputPort(4).Data;drive=block.InputPort(5).Data;
  row=make_row(t,state(1:24),power,tele(1:12)',drive(1),tele(14),state(25),p,state(26),flags(1),flags(2));
  block.OutputPort(1).Data=[row';state(27:29)];
  block.OutputPort(2).Data=row(36);block.OutputPort(3).Data=row(4);
  block.OutputPort(4).Data=[row(27);row(35)];
end
end

function sl_update(block)
kind=block.DialogPrm(1).Data;p=block.DialogPrm(2).Data;c=block.DialogPrm(3).Data;
Ts=1/p.fsw;t=round(block.CurrentTime/Ts)*Ts;
% Outputs are pure. Commit state exactly once in Update, never in Outputs.
switch kind
 case 'load'
  [~,~,~,next]=sl_load(t,block.Dwork(1).Data,p,c);block.Dwork(1).Data=next;
 case 'controller'
  [~,~,next]=sl_control(t,block.Dwork(1).Data,block.InputPort(1).Data,block.InputPort(2).Data,p,c);
  block.Dwork(1).Data=next;
 case 'plant'
  block.Dwork(1).Data=sl_plant(t,block.Dwork(1).Data,block.InputPort(1).Data,block.InputPort(2).Data,p);
end
end

function [power,q,flags,next]=sl_load(t,idx,p,c)
Ts=1/p.fsw;k=round(t/Ts);restoring=k>=round(c.task/Ts);connected=c.on||restoring;
if restoring,power=0;else,[power,idx]=load_at(c.profile,t,idx);end
[q,next]=load_integrals(c,t,t+Ts,restoring,idx);flags=[double(restoring);double(connected)];
end

function [command,telemetry,next]=sl_control(t,state,sense,power,p,c)
% p is ALWAYS the nominal controller, never actual plant parameters.
% sense = [current, speed, bus V, last-cycle mean current, previous speed].
Ts=1/p.fsw;k=round(t/Ts);u=state(1:12)';xi=state(13);imeas=sense(4);
restoring=k>=round(c.task/Ts);connected=c.on||restoring;
if k==0,u(12)=sense(3);
elseif c.on && ~state(15)
 % Pay/earn the work from the PREVIOUS cycle before making this decision.
 work=p.Ke*.5*(sense(5)+sense(2))*imeas*Ts;gain=0;
 if state(14)<0 && u(1)>0,gain=p.credit_margin*max(work,0);end
 used=max(-work,0);leak=p.credit_decay*max(u(8),0)*Ts;
 u(8)=u(8)+gain-used-leak;u(9)=u(9)+gain;u(10)=u(10)+used;u(11)=u(11)+leak;
end
y=zeros(24,1);y(1:3)=sense(1:3);
if mod(k,round(p.outer/Ts))==0,u=outer_control(y,power,t,p,c,u,restoring);end
enabled=connected && ~u(6);d=0;
if enabled
 err=u(1)-imeas;delta=p.td/Ts;
 raw=p.Ke*y(2)+(p.R+p.Ron)*u(1)+p.Kp*err+xi+ ...
  delta*(y(3)+2*p.Vf)*max(-1,min(1,imeas/p.blend))+2*delta*(p.Rd-p.Ron)*imeas;
 d=max(0,min(1,raw/y(3)));
 if (raw>=0 && raw<=y(3))||(raw>y(3) && err<0)||(raw<0 && err>0),xi=xi+Ts*p.Ki*err;end
end
command=[d;double(enabled)];telemetry=[u';d;xi];next=[u';xi;power;double(restoring)];
end

function command=sl_driver(command,p)
% Hardware minimum-pulse rule belongs to the driver, not the controller.
minimum=2.2*p.td*p.fsw;d=command(1);
if d>0 && d<minimum,d=0;elseif d>1-minimum && d<1,d=1;end
command(1)=d;
end

function state=sl_plant(t,state,command,q,p)
Ts=1/p.fsw;k=round(t/Ts);y=state(1:24);g=state(25:28)';q0=y(17);w_before=y(2);
s=struct('max_current_A',state(32),'max_balance_J',state(33),'max_midpoint_iterations',state(34), ...
 'midpoint_defect',state(35),'zero_events',state(36));
[phases,g]=gate_schedule(t,(k+1)*Ts,command(1),logical(command(2)),g,p);
[y,s]=midpoint_step(y,t,t+Ts,phases,q,p,false,s);
imeas=(y(17)-q0)/Ts;s.max_balance_J=max(s.max_balance_J,abs(balance(y,p,state(31))));
state=[y;g';imeas;w_before;state(31);s.max_current_A;s.max_balance_J; ...
 s.max_midpoint_iterations;s.midpoint_defect;s.zero_events];
end
